# Brevo (current launch). Keep this key server-only.
BREVO_API_KEY=
BREVO_LIST_ATHLETE=
BREVO_LIST_COACH=
BREVO_LIST_PARTNER=
BREVO_LIST_GLOBAL=
# Active template containing Brevo's double-opt-in link.
BREVO_DOI_TEMPLATE_ID=

# Sanity is optional. Leave unset to use the built-in website content.
# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Server-only token used by /api/waitlist, /api/inquiry and the lead worker.
# Grant only create/read/update permissions for the private lead document types.
# Never expose this value through a NEXT_PUBLIC variable.
SANITY_API_WRITE_TOKEN=

# Optional durable lead-delivery bridge. Empty values disable the worker.
# Select/approve the provider and processor terms before supplying credentials.
# Use separate randomly generated secrets of at least 32 characters each.
# A trusted scheduler must POST /api/internal/lead-delivery with:
# Authorization: Bearer <LEAD_DELIVERY_JOB_SECRET>
# Schedule every minute; up to five due events are processed per invocation.
# The hosting runtime must permit a 60-second request. No request background jobs.
LEAD_DELIVERY_JOB_SECRET=
# Operator-controlled HTTPS receiver only; redirects and URL credentials refused.
LEAD_DELIVERY_WEBHOOK_URL=
LEAD_DELIVERY_WEBHOOK_SECRET=
# Bridge contract: persist/deduplicate Idempotency-Key (deliveryEventId) before
# side effects and return 2xx only after durable acceptance. "delivered" in Sanity
# means bridge acceptance, never proof of email delivery or team response.
# waitlist.joined: retain access request; start double opt-in ONLY when updates
# state is double_opt_in_requested. No updates until provider-verified DOI.
# not_requested is NOT a withdrawal and must not change provider subscription.
# Preserve unsubscribe/suppression; a new request never bypasses fresh DOI.
# assessment.requested (athletes) / inquiry.received (legacy coach/partner):
# route to the responsible team for a personal response;
# never enroll inquiries in marketing. The provider owns DOI, unsubscribe,
# bounce/suppression handling and actual email-delivery monitoring.
# Review failed events/stateWriteFailed alerts. Five attempts then dead letter;
# approved replay must retain event ID, reset attempts/status, and clear lease.
# Records without deliveryStatus are intentionally not backfilled.

# Local seed script only. Do not configure these in the hosting platform.
SANITY_SEED_TOKEN=
# Must exactly match "<project-id>/<dataset>" for an intentional overwrite.
SANITY_SEED_CONFIRM=

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
