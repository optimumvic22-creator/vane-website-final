{
  "name": "vane-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "media:check": "node scripts/check-media.mjs",
    "launch:check": "node --env-file-if-exists=.env.local scripts/check-launch-readiness.mjs",
    "launch:privacy": "node --env-file-if-exists=.env.local scripts/check-lead-privacy.mjs"
  },
  "dependencies": {
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^6.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.563.0",
    "next": "^16.3.3",
    "next-sanity": "^13.3.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.16.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "adm-zip": "0.6.1"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.0"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
